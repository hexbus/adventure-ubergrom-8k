* SPDX-License-Identifier: Apache-2.0
* OPEN stages one file; record READ/WRITE operate on that buffer. CLOSE
* commits a dirty file through the PROGRAM writer. No second open file.
* Volatile record handles. One shared 3616-byte buffer, no caller VDP workspace.
* Offsets: active, PAB flags, buffer(2), stored(2), logical(2), count(2),
* reclen, TI flags, record position(2), byte position(2), dirty, reserved,
* canonical name(10). Remaining bytes reserved and cleared.
HPTR   EQU >7090
HFREE  EQU >7092
SOURCE EQU >7094
REQNAME EQU >70A0
RPOS   EQU >70B0
RBYTE  EQU >70B2
RLEN   EQU >70B4
OLDLEN EQU >70B6
NEWLEN EQU >70B8
RVDP   EQU >70BA
CTX    EQU >7580
HANDLE1 EQU >7500
HANDLE2 EQU >7540
HSIG   EQU >75F0

HINIT  MOVE 4,G@HSIG,@>8350
       DCEQ >5542,@>8350
       BR HRESET
       DCEQ >4631,@>8352
       BS HREADY
HRESET MOVE 120,G@ZEROS,G@HANDLE1
       MOVE 4,G@HSIGN,G@HSIG
HREADY RTN
HSIGN  TEXT 'UBF1'
* Console power-up list return convention: advance its pending GPL stack.
POWERUP DST @>83FA,@>834A
       DST >9838,@>83FA
       MOVE 2,G@>A000,@>8350
       DCEQ >05FA,@>8350
       BR POWERDONE
       MOVE 1,G@>A0E5,@>8350
       CZ @>8350
       BR POWERDONE
       MOVE 1,G@>A0ED,@>8350
       CEQ >FF,@>8350
       BR POWERDONE
       MOVE 4,G@ZEROS,G@HSIG
POWERDONE DST @>834A,@>83FA
       DST *>8372,*>8373
       DECT @>8372
       RTN
* Requested canonical name; zero length is reserved for the directory.
INPUTNAME DST REQNAME,@>8350
       DCLR @>8352
       ST V@>FFFF(@>4C),@>8353
       DSUB 5,@>8352
INAMELP DCZ @>8352
       BS INAMEOK
       CALL READGBYTE
       CEQ >2D,@>835F
       BS INAMENEXT
       CEQ >5F,@>835F
       BS INAMENEXT
       CH >2F,@>835F
       BR INAMEBAD
       CH >39,@>835F
       BR INAMENEXT
       CH >40,@>835F
       BR INAMEBAD
       CH >5A,@>835F
       BS INAMEBAD
INAMENEXT DINC @>8350
       DDEC @>8352
       B INAMELP
INAMEBAD ST 1,@>835F
       RTN
INAMEOK CLR @>835F
       RTN

HLOOK  MOVE 4,G@ZEROS,G@HPTR
       DST HANDLE1,@>8350
HLOOP  CALL READGBYTE
       CEQ >A5,@>835F
       BS HCMP
       MOVE 2,@>8350,G@HFREE
       BR HNEXT
HCMP   DST @>8350,@>8352
       DADD 18,@>8352
       DST REQNAME,@>8354
       ST 10,@>835E
HCMPLP MOVE 1,G@>0000(@>52),@>8358
       MOVE 1,G@>0000(@>54),@>8359
       CEQ @>8358,@>8359
       BR HNEXT
       DINC @>8352
       DINC @>8354
       DEC @>835E
       CZ @>835E
       BR HCMPLP
       MOVE 2,@>8350,G@HPTR
       MOVE 64,G@>0000(@>50),G@CTX
       RTN
HNEXT RTN
HPUT   CALL GETHANDLE
       MOVE 64,G@CTX,G@>0000(@>50)
       RTN

BADATTR OR >40,V@>FFF7(@>4C)
       B DONE
EOF    OR >A0,V@>FFF7(@>4C)
       B DONE

       .IFNDEF PROGRAMONLY
OPEN   CALL GETHANDLE
       DCZ @>8350
       BR BADATTR
       MOVE 2,G@HFREE,@>8350
       DCZ @>8350
       BS FULL
       MOVE 2,@>8350,G@HPTR
       MOVE 64,G@ZEROS,G@CTX
       DST >6000,@>8352
OPBUFFER MOVE 2,@>8352,G@CTX+2
       MOVE 10,G@REQNAME,G@CTX+18
       MOVE 1,G@PAB+1,@>835F
       MOVE 1,@>835F,G@CTX+1
       AND >11,@>835F
       CEQ >11,@>835F
       BS BADATTR
       MOVE 1,G@NLEN,@>835F
       CZ @>835F
       BS CATALOG
       MOVE 2,G@MATCH,@>8350
       DCZ @>8350
       BS OPNEW
       CALL SETHEAD
       CALL GETMETA
       MOVE 1,G@PAB+1,@>835F
       AND 6,@>835F
       CEQ 4,@>835F
       BS OPINPUT
       MOVE 1,G@META+10,@>835F
       AND 8,@>835F
       CZ @>835F
       BR PROTECT
       MOVE 1,G@PAB+1,@>835F
       AND 6,@>835F
       CEQ 2,@>835F
       BS OPNEW
OPINPUT MOVE 1,G@META+10,@>835F
       AND 1,@>835F
       CZ @>835F
       BR BADATTR
       MOVE 1,G@META+11,@>835F
       CZ @>835F
       BR BADOP
       MOVE 1,G@META+10,@>835E
       ST @>835E,@>835F
       AND >80,@>835F
       SRL 3,@>835F
       AND 2,@>835E
       SLL 2,@>835E
       OR @>835E,@>835F
       MOVE 1,G@PAB+1,@>835E
       AND >18,@>835E
       CEQ @>835F,@>835E
       BR BADATTR
       MOVE 1,G@META+21,@>835F
       MOVE 1,G@PAB+4,@>835E
       CZ @>835E
       BS OPLENGTH
       CEQ @>835F,@>835E
       BR BADATTR
OPLENGTH MOVE 1,@>835F,G@CTX+10
       MOVE 1,G@META+10,G@CTX+11
       MOVE 2,G@META+14,G@CTX+4
       MOVE 2,G@META+12,G@CTX+6
       MOVE 2,G@META+22,G@CTX+8
       MOVE 2,G@CTX+2,G@DPTR
       MOVE 2,G@CTX+4,G@DLEFT
       CALL SETREFS
       .ENDIF
OPCOPY CALL GETLEFT
       DCZ @>8352
       BS OPAPPEND
       CALL NEXTAU
       CALL GETLEFT
       DCH 32,@>8352
       BR OPCSZ
       DST 32,@>8352
OPCSZ  MOVE 2,G@DPTR,@>8354
       MOVE @>8352,G@>0000(@>50),G@>0000(@>54)
       CALL ADVANCE
       B OPCOPY
OPNEW  MOVE 1,G@PAB+1,@>835F
       AND 6,@>835F
       CEQ 4,@>835F
       BS NOFILE
       ST 1,@>835F
       MOVE 1,@>835F,G@CTX+16
       MOVE 1,G@PAB+4,@>835F
       CZ @>835F
       BR OPDEFLEN
       ST 80,@>835F
OPDEFLEN MOVE 1,@>835F,G@CTX+10
       MOVE 1,G@PAB+1,@>835E
       ST @>835E,@>835F
       AND 8,@>835E
       SRL 2,@>835E
       AND >10,@>835F
       SLL 3,@>835F
       OR @>835E,@>835F
       MOVE 1,@>835F,G@CTX+11
       AND >80,@>835F
       CZ @>835F
       BS OPAPPEND
       MOVE 1,G@CTX+10,@>835F
       CEQ 255,@>835F
       BS BADATTR
OPAPPEND
       .IFDEF PROGRAMONLY
       B CLONENAME
       .ELSE
       MOVE 1,G@SOURCE,@>835F
       CEQ 2,@>835F
       BS CLONENAME
       MOVE 1,G@PAB+1,@>835F
       AND 6,@>835F
       CEQ 6,@>835F
       BR OPACTIVE
       MOVE 2,G@CTX+8,G@CTX+12
       MOVE 2,G@CTX+4,G@CTX+14
OPACTIVE ST >A5,@>835F
       MOVE 1,@>835F,G@CTX
       MOVE 1,G@CTX+10,V@>FFFA(@>4C)
       CALL HPUT
       B DONE

RECORD CALL GETHANDLE
       DCZ @>8350
       BS BADOP
       MOVE 1,G@CTX+1,@>835F
       CEQ @>835F,V@>FFF7(@>4C)
       BR BADOP
       CEQ 10,V@>FFF6(@>4C)
       BS ABORT
       CEQ 1,V@>FFF6(@>4C)
       BS CLOSE
       CEQ 4,V@>FFF6(@>4C)
       BS REWIND
       MOVE 2,G@CTX+12,G@RPOS
       MOVE 1,G@CTX+1,@>835F
       AND 1,@>835F
       CZ @>835F
       BS RSEQ
       MOVE 2,G@PAB+6,G@RPOS
RSEQ   CEQ 2,V@>FFF6(@>4C)
       BR RPOSITION
       MOVE 1,G@CTX+1,@>835F
       AND 2,@>835F
       CZ @>835F
       BR BADOP
       MOVE 2,G@CTX+8,@>8350
       MOVE 2,G@RPOS,@>8352
       DCH @>8352,@>8350
       BR EOF
RPOSITION MOVE 2,G@RPOS,@>8352
       DCH 3616,@>8352
       BS FULL
       MOVE 1,G@CTX+11,@>835F
       AND >80,@>835F
       CZ @>835F
       BR RVARIABLE
       DCLR @>8350
       DCLR @>8354
       MOVE 1,G@CTX+10,@>8355
* Bounded multiplication avoids GPL's four-byte product scratch convention.
RMULT  DCZ @>8352
       BS RLOCATED
       DADD @>8354,@>8350
       DCH 3616,@>8350
       BS FULL
       DDEC @>8352
       B RMULT
RVARIABLE MOVE 2,G@CTX+14,@>8350
RLOCATED MOVE 2,@>8350,G@RBYTE
       CEQ 2,V@>FFF6(@>4C)
       BS READREC
       CEQ 3,V@>FFF6(@>4C)
       BS WRITEREC
       B BADOP

REWIND MOVE 4,G@ZEROS,G@CTX+12
       CALL HPUT
       B DONE
CLOSE  MOVE 1,G@CTX+16,@>835F
       CZ @>835F
       BS ABORT
       ST 1,@>835F
       MOVE 1,@>835F,G@SOURCE
       B MOUNT
ABORT  CALL GETHANDLE
       MOVE 1,G@ZEROS,G@>0000(@>50)
       B DONE

READREC CALL RECPTR
       CALL RECBOUND
       CZ @>835F
       BR BADIO
       CALL RECVDP
       CZ @>835F
       BR NOSPACE
       DCZ @>8352
       BS READMOVED
       MOVE @>8352,G@>0000(@>50),V*>8354
READMOVED ST @>8353,V@>FFFB(@>4C)
       DADD @>8352,@>8350
       MOVE 2,G@CTX+2,@>8354
       DSUB @>8354,@>8350
       MOVE 2,@>8350,G@CTX+14
       B RECSTEP
* RECPTR returns data address and actual length, excludes variable prefix.
RECPTR CALL RECADDR
       DCLR @>8352
       MOVE 1,G@CTX+11,@>835F
       AND >80,@>835F
       CZ @>835F
       BR RPVAR
       MOVE 1,G@CTX+10,@>8353
       RTN
RPVAR  MOVE 1,G@>0000(@>50),@>8353
       DINC @>8350
       RTN
* Bound record access by the staged file length and declared record length.
RECBOUND MOVE 2,G@CTX+2,@>8354
       MOVE 2,G@CTX+4,@>8356
       DADD @>8354,@>8356
       DST @>8350,@>8354
       DADD @>8352,@>8354
       DCH @>8356,@>8354
       BS RVDPBAD
       MOVE 1,G@CTX+10,@>835F
       CH @>835F,@>8353
       BS RVDPBAD
       CLR @>835F
       RTN
* RECVDP preserves source/length, refuses a buffer crossing >3FFF.
RECVDP MOVE 2,G@PAB+2,@>8354
       DCH >3FFF,@>8354
       BS RVDPBAD
       DST @>8354,@>8356
       DADD @>8352,@>8356
       DCH >4000,@>8356
       BS RVDPBAD
       CLR @>835F
       RTN
RVDPBAD ST 1,@>835F
       RTN
RECSTEP MOVE 2,G@RPOS,@>8350
       DINC @>8350
       MOVE 2,@>8350,G@CTX+12
       DST @>8350,V@>FFFC(@>4C)
       CALL HPUT
       B DONE

WRITEREC MOVE 1,G@CTX+1,@>835F
       AND 6,@>835F
       CEQ 4,@>835F
       BS BADOP
       CEQ 6,@>835F
       BR WRMODE
       MOVE 2,G@RPOS,@>8350
       MOVE 2,G@CTX+8,@>8352
       DCEQ @>8350,@>8352
       BR BADOP
WRMODE DCLR @>8352
       MOVE 1,G@CTX+10,@>8353
       MOVE 1,G@CTX+11,@>835F
       AND >80,@>835F
       CZ @>835F
       BS WRLENGTH
       MOVE 1,G@PAB+5,@>835F
       CH @>8353,@>835F
       BS BADATTR
       ST @>835F,@>8353
WRLENGTH MOVE 2,@>8352,G@RLEN
       CALL RECVDP
       CZ @>835F
       BR NOSPACE
       MOVE 2,@>8354,G@RVDP
       MOVE 2,G@RBYTE,@>8350
       DADD @>8352,@>8350
       MOVE 1,G@CTX+11,@>835F
       AND >80,@>835F
       CZ @>835F
       BR WRVAR
       DCH 3616,@>8350
       BS FULL
       MOVE 2,@>8350,G@NEWLEN
       MOVE 2,G@CTX+4,@>8352
       DCH @>8352,@>8350
       BR WRFIXED
* Zero-fill gaps in a relative fixed file before extending its length.
       MOVE 2,G@CTX+2,@>8354
       DADD @>8352,@>8354
WRGAP  DCEQ @>8352,@>8350
       BS WREXTEND
       MOVE 1,G@ZEROS,G@>0000(@>54)
       DINC @>8352
       DINC @>8354
       B WRGAP
WREXTEND MOVE 2,@>8350,G@CTX+4
       MOVE 2,@>8350,G@CTX+6
       MOVE 2,G@RPOS,@>8350
       DINC @>8350
       MOVE 2,@>8350,G@CTX+8
WRFIXED CALL RECADDR
       B WRDATA
* Replace a variable record, moving its tail in the safe overlap direction.
WRVAR  MOVE 2,G@RPOS,@>8350
       MOVE 2,G@CTX+8,@>8352
       DCH @>8352,@>8350
       BS BADOP
       DCEQ @>8352,@>8350
       BS WRVARNEW
       CALL RECPTR
       CALL RECBOUND
       CZ @>835F
       BR BADIO
       DINC @>8352
       B WRVAROLD
WRVARNEW DCLR @>8352
WRVAROLD MOVE 2,@>8352,G@OLDLEN
       MOVE 2,G@CTX+4,@>8350
       DSUB @>8352,@>8350
       MOVE 2,G@RLEN,@>8352
       DINC @>8352
       DADD @>8352,@>8350
       DCH 3616,@>8350
       BS FULL
       MOVE 2,@>8350,G@NEWLEN
       MOVE 2,G@RBYTE,@>8354
       MOVE 2,G@OLDLEN,@>8356
       DADD @>8356,@>8354
       MOVE 2,G@CTX+4,@>8356
       DSUB @>8354,@>8356
       MOVE 2,G@CTX+2,@>8350
       DADD @>8350,@>8354
       MOVE 2,G@RBYTE,@>8352
       DADD @>8350,@>8352
       MOVE 2,G@RLEN,@>8350
       DINC @>8350
       DADD @>8350,@>8352
       DCH @>8354,@>8352
       BR WRSHIFTUP
       DADD @>8356,@>8354
       DADD @>8356,@>8352
WRSHIFTDOWN DCZ @>8356
       BS WRSHIFTED
       DDEC @>8354
       DDEC @>8352
       MOVE 1,G@>0000(@>54),G@>0000(@>52)
       DDEC @>8356
       B WRSHIFTDOWN
WRSHIFTUP DCZ @>8356
       BS WRSHIFTED
       MOVE 1,G@>0000(@>54),G@>0000(@>52)
       DINC @>8354
       DINC @>8352
       DDEC @>8356
       B WRSHIFTUP
WRSHIFTED MOVE 2,G@NEWLEN,G@CTX+4
       MOVE 2,G@OLDLEN,@>8350
       DCZ @>8350
       BR WRVREPLACE
       MOVE 2,G@CTX+8,@>8350
       DINC @>8350
       MOVE 2,@>8350,G@CTX+8
       DST 1,@>8350
WRVREPLACE DDEC @>8350
       MOVE 2,G@CTX+6,@>8352
       DSUB @>8350,@>8352
       MOVE 2,G@RLEN,@>8350
       DADD @>8350,@>8352
       MOVE 2,@>8352,G@CTX+6
       CALL RECADDR
       MOVE 1,G@RLEN+1,G@>0000(@>50)
       DINC @>8350
WRDATA MOVE 2,G@RLEN,@>8352
       MOVE 2,G@RVDP,@>8354
       DCZ @>8352
       BS WRDATAMOVED
       MOVE @>8352,V*>8354,G@>0000(@>50)
WRDATAMOVED DADD @>8352,@>8350
       MOVE 2,G@CTX+2,@>8352
       DSUB @>8352,@>8350
       MOVE 2,@>8350,G@CTX+14
       ST 1,@>835F
       MOVE 1,@>835F,G@CTX+16
       B RECSTEP
       .ENDIF

STATUS CLR V@>FFFE(@>4C)
       CALL SPACEINFO
       MOVE 2,G@CATFREE,@>8350
       DCZ @>8350
       BS STATFULL
       MOVE 2,G@CATCOUNT,@>8350
       DCEQ 16,@>8350
       BR STATOPEN
STATFULL OR 2,V@>FFFE(@>4C)
STATOPEN CALL GETHANDLE
       DCZ @>8350
       BS STATDISK
       MOVE 1,G@CTX+11,G@META+10
       B STATFLAGS
STATDISK
       MOVE 2,G@MATCH,@>8350
       DCZ @>8350
       BR STATFILE
       OR >80,V@>FFFE(@>4C)
       B DONE
STATFILE CALL SETHEAD
       CALL GETMETA
STATFLAGS MOVE 1,G@META+10,@>835E
       ST @>835E,@>835F
       AND >0B,@>835F
       SLL 3,@>835F
       AND >80,@>835E
       SRL 5,@>835E
       OR @>835E,@>835F
       OR @>835F,V@>FFFE(@>4C)
       CALL GETHANDLE
       DCZ @>8350
       BS DONE
       MOVE 2,G@CTX+12,@>8350
       MOVE 2,G@CTX+8,@>8352
       DCH @>8350,@>8352
       BS DONE
       OR 1,V@>FFFE(@>4C)
       B DONE
* Private opcode 12: exact native copy, including protection and codec.
* Buffer points to a length-prefixed destination (UBE1.NAME). The record file
* must be closed. The source remains unchanged; destination commits atomically.
CLONE  MOVE 1,G@HANDLE1,@>835F
       CEQ >A5,@>835F
       BS BADOP
       MOVE 2,G@PAB+2,@>8350
       DCH >3FF0,@>8350
       BS NOSPACE
       ST V*>8350,@>835F
       CH 5,@>835F
       BR NOFILE
       CH 15,@>835F
       BS NOFILE
       DCEQ >5542,V@1(@>50)
       BR BADOP
       DCEQ >4531,V@3(@>50)
       BR BADOP
       CEQ >2E,V@5(@>50)
       BR BADOP
       MOVE 2,G@MATCH,@>8350
       DCZ @>8350
       BS NOFILE
       CALL SETHEAD
       CALL GETMETA
       MOVE 64,G@ZEROS,G@CTX
       MOVE 2,G@META+12,G@CTX+6
       MOVE 2,G@META+14,G@CTX+4
       MOVE 2,G@META+22,G@CTX+8
       MOVE 1,G@META+21,G@CTX+10
       MOVE 1,G@META+10,G@CTX+11
       MOVE 1,G@META+11,G@CTX+17
       DST >6000,@>8350
       MOVE 2,@>8350,G@CTX+2
       MOVE 2,@>8350,G@DPTR
       MOVE 2,G@CTX+4,G@DLEFT
       MOVE 2,G@ZEROS,G@HPTR
       ST 2,@>835F
       MOVE 1,@>835F,G@SOURCE
       CALL SETREFS
       B OPCOPY
CLONENAME MOVE 2,G@PAB+2,@>8350
       DCLR @>8352
       ST V*>8350,@>8353
       ST @>8353,V@>FFFF(@>4C)
       DINC @>8350
       MOVE @>8352,V*>8350,V*>834C
       DSUB 5,@>8352
       DADD 5,@>8350
       MOVE 10,G@SPACES,G@REQNAME
       MOVE @>8352,V*>8350,G@REQNAME
       CALL INPUTNAME
       CZ @>835F
       BR NOFILE
       ST 6,V@>FFF6(@>4C)
       B MOUNT
       COPY "directory.gpl"
       .IFDEF PROGRAMONLY
OPEN
RECORD B BADOP
       .ENDIF


